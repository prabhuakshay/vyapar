# =============================================================================
# vyapar environment configuration
# =============================================================================
# Copy to `.env` in the project root and fill in values:
#
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit real secrets.
# Real environment variables take precedence over values in `.env`.
#
# Format notes:
#   - Booleans accept: true/false, 1/0, yes/no, on/off.
#   - Lists are comma-separated, no spaces: a,b,c
#   - Lines starting with # are ignored. Commented-out keys use the default.
#   - Quote values containing `#` or spaces: KEY="value # not a comment"


# =============================================================================
# CORE
# =============================================================================

# SECRET_KEY (required, no default)
# Signs sessions, password reset tokens, CSRF tokens and messages.
# Must be long, random and unique per environment. Leaking it lets attackers
# forge sessions. Generate with:
#
#     uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
SECRET_KEY=change-me

# SECRET_KEY_FALLBACKS (default: empty)
# Previous secret keys, comma-separated. Used to rotate SECRET_KEY without
# logging everyone out: move the old key here, set a new SECRET_KEY, and remove
# the old key once existing sessions have expired (SESSION_COOKIE_AGE).
# SECRET_KEY_FALLBACKS=old-key-1,old-key-2

# DEBUG (default: false)
# Shows detailed error pages and relaxes HTTPS-only security defaults.
# NEVER enable in production: it leaks settings, code and SQL to visitors.
DEBUG=true

# ALLOWED_HOSTS (default: empty)
# Host/domain names this site may serve, comma-separated. Requests with any
# other Host header get a 400. A leading dot matches subdomains (.example.com).
# If empty while DEBUG=true, localhost / 127.0.0.1 / [::1] are allowed.
# Production example: ALLOWED_HOSTS=example.com,www.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF_TRUSTED_ORIGINS (default: empty)
# Full origins (scheme + host [+ port]) allowed to submit unsafe requests
# (POST etc.) over HTTPS when the origin differs from the Host header, e.g.
# behind some proxies or for cross-subdomain forms.
# Example: CSRF_TRUSTED_ORIGINS=https://example.com,https://*.example.com
# CSRF_TRUSTED_ORIGINS=

# ADMIN_URL (default: admin/)
# URL path of the Django admin. Must end with a slash. Using an unguessable
# path in production cuts down on automated login attacks. Generate with:
#
#     uv run python -c "import secrets; print(secrets.token_urlsafe(12) + '/')"
#
# ADMIN_URL=admin/


# =============================================================================
# DATABASE
# =============================================================================

# DATABASE_URL (required, no default)
# PostgreSQL connection URL: postgres://USER:PASSWORD@HOST:PORT/NAME
# Append ?sslmode=require for managed databases that enforce TLS.
# URL-encode special characters in the password (e.g. @ -> %40). Encode with:
#
#     uv run python -c "import urllib.parse; print(urllib.parse.quote(input(), safe=''))"
#
# Create a local role and database (run as a postgres superuser):
#
#     sudo -u postgres createuser --createdb --pwprompt vyapar
#     sudo -u postgres createdb --owner vyapar vyapar
#
# --createdb lets the test runner create its throwaway test database.
DATABASE_URL=postgres://vyapar:vyapar@localhost:5432/vyapar

# CONN_MAX_AGE (default: 60)
# Seconds to keep a database connection open for reuse across requests.
# 0 closes the connection after every request.
# CONN_MAX_AGE=60

# CONN_HEALTH_CHECKS (default: true)
# Check a reused connection is still alive before each request, so a database
# restart doesn't surface as errors. Only matters when CONN_MAX_AGE > 0.
# CONN_HEALTH_CHECKS=true

# ATOMIC_REQUESTS (default: false)
# Wrap every view in a transaction: all or nothing per request. Simpler data
# integrity at the cost of holding transactions open for the whole view.
# ATOMIC_REQUESTS=false


# =============================================================================
# CACHE
# =============================================================================

# CACHE_URL (default: locmemcache://)
# Cache backend URL. locmem is per-process, so with multiple workers each has
# its own cache; use Redis in production. Formats:
#   Local memory: locmemcache://
#   Disabled:     dummycache://
#   Database:     dbcache://cache_table   (run `manage.py createcachetable`)
#   File:         filecache:///var/tmp/django_cache
#   Redis:        redis://HOST:6379/0     (needs `uv add redis`)
# CACHE_URL=locmemcache://


# =============================================================================
# INTERNATIONALIZATION
# =============================================================================

# LANGUAGE_CODE (default: en-us)
# Default language for translations and formatting.
# LANGUAGE_CODE=en-us

# TIME_ZONE (default: UTC)
# Time zone used to display datetimes. Datetimes are always stored in UTC.
# Any IANA name, e.g. Asia/Kolkata, Europe/London.
# TIME_ZONE=UTC


# =============================================================================
# STATIC & MEDIA FILES
# =============================================================================

# STATIC_URL (default: static/)
# URL prefix for static files (CSS, JS, images). Served by WhiteNoise, so no
# separate web server is needed. Set to a full CDN URL to serve from a CDN.
# STATIC_URL=static/

# STATIC_ROOT (default: <project root>/staticfiles)
# Directory `manage.py collectstatic` copies static files into. Run
# collectstatic on every deploy; WhiteNoise compresses and fingerprints them.
# STATIC_ROOT=/srv/vyapar/staticfiles

# MEDIA_URL (default: media/)
# URL prefix for user-uploaded files. WhiteNoise does NOT serve these; in
# production serve MEDIA_ROOT via your web server or object storage.
# MEDIA_URL=media/

# MEDIA_ROOT (default: <project root>/media)
# Directory where user-uploaded files are stored. Back it up.
# MEDIA_ROOT=/srv/vyapar/media


# =============================================================================
# EMAIL
# =============================================================================

# EMAIL_BACKEND (default: django.core.mail.backends.console.EmailBackend)
# How email is sent. Options:
#   django.core.mail.backends.console.EmailBackend  - print to stdout (dev)
#   django.core.mail.backends.smtp.EmailBackend     - send via SMTP (prod)
#   django.core.mail.backends.locmem.EmailBackend   - keep in memory (tests)
#   django.core.mail.backends.dummy.EmailBackend    - discard
# The EMAIL_HOST..EMAIL_TIMEOUT values below apply only to the SMTP backend.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# EMAIL_HOST (default: localhost)
# SMTP server hostname, e.g. smtp.gmail.com, smtp.sendgrid.net.
# EMAIL_HOST=smtp.example.com

# EMAIL_PORT (default: 587)
# 587 for STARTTLS (EMAIL_USE_TLS=true), 465 for implicit SSL
# (EMAIL_USE_SSL=true), 25 for unencrypted.
# EMAIL_PORT=587

# EMAIL_HOST_USER (default: empty)
# SMTP username. Leave empty if the server doesn't require auth.
# EMAIL_HOST_USER=

# EMAIL_HOST_PASSWORD (default: empty)
# SMTP password or provider API key / app password.
# EMAIL_HOST_PASSWORD=

# EMAIL_USE_TLS (default: true)
# Upgrade the connection with STARTTLS (usually port 587).
# Mutually exclusive with EMAIL_USE_SSL.
# EMAIL_USE_TLS=true

# EMAIL_USE_SSL (default: false)
# Use implicit TLS from the start (usually port 465).
# Mutually exclusive with EMAIL_USE_TLS.
# EMAIL_USE_SSL=false

# EMAIL_TIMEOUT (default: 10)
# Seconds to wait for the SMTP server before giving up, so a slow mail server
# can't hang request workers.
# EMAIL_TIMEOUT=10

# DEFAULT_FROM_EMAIL (default: webmaster@localhost)
# Sender address for regular emails (password resets, notifications).
# DEFAULT_FROM_EMAIL="vyapar <no-reply@example.com>"

# SERVER_EMAIL (default: root@localhost)
# Sender address for error reports sent to ADMINS.
# SERVER_EMAIL=errors@example.com

# EMAIL_SUBJECT_PREFIX (default: "[vyapar] ")
# Prefix for subjects of emails sent to ADMINS / MANAGERS. Keep the trailing
# space and quote the value.
# EMAIL_SUBJECT_PREFIX="[vyapar] "

# ADMINS (default: empty)
# Email addresses, comma-separated, that receive error reports (500s) when
# DEBUG=false. Also used as MANAGERS (broken link reports).
# ADMINS=ops@example.com,dev@example.com


# =============================================================================
# SECURITY
# =============================================================================
# These default to secure values when DEBUG=false and relaxed values when
# DEBUG=true. Verify a production config with:
#
#     uv run python manage.py check --deploy
#

# USE_X_FORWARDED_PROTO (default: false)
# Trust the X-Forwarded-Proto header to detect HTTPS. Enable ONLY behind a
# reverse proxy / load balancer (nginx, Caddy, Heroku, ...) that terminates
# TLS and always sets or strips this header; otherwise clients can spoof it.
# Without it behind such a proxy, SECURE_SSL_REDIRECT causes a redirect loop.
# USE_X_FORWARDED_PROTO=false

# SECURE_SSL_REDIRECT (default: true when DEBUG=false, else false)
# Redirect all HTTP requests to HTTPS. Disable if the proxy already does this.
# SECURE_SSL_REDIRECT=true

# SECURE_HSTS_SECONDS (default: 31536000 (1 year) when DEBUG=false, else 0)
# Tells browsers to only use HTTPS for this many seconds. Browsers cache this:
# a wrong value can lock users out of a broken HTTPS site. When first enabling
# HTTPS, start with 3600, confirm everything works, then raise.
# SECURE_HSTS_SECONDS=31536000

# SECURE_HSTS_INCLUDE_SUBDOMAINS (default: false)
# Apply HSTS to all subdomains too. Enable only if EVERY subdomain serves HTTPS.
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false

# SECURE_HSTS_PRELOAD (default: false)
# Allow submission to browsers' built-in HSTS preload list (hstspreload.org).
# Hard to undo. Requires INCLUDE_SUBDOMAINS and HSTS_SECONDS >= 31536000.
# SECURE_HSTS_PRELOAD=false

# SESSION_COOKIE_SECURE (default: true when DEBUG=false, else false)
# Send the session cookie over HTTPS only.
# SESSION_COOKIE_SECURE=true

# CSRF_COOKIE_SECURE (default: true when DEBUG=false, else false)
# Send the CSRF cookie over HTTPS only.
# CSRF_COOKIE_SECURE=true

# SESSION_COOKIE_AGE (default: 1209600 (2 weeks))
# Seconds before a login session expires.
# SESSION_COOKIE_AGE=1209600


# =============================================================================
# GUNICORN
# =============================================================================
# Production app server. Start with `uv run gunicorn` from the project root;
# it picks up gunicorn.conf.py, which reads these values.

# GUNICORN_BIND (default: 0.0.0.0:8000)
# Address(es) to listen on, comma-separated. Use 127.0.0.1:8000 when a reverse
# proxy runs on the same host, or unix:/run/vyapar.sock for a Unix socket.
# GUNICORN_BIND=0.0.0.0:8000

# WEB_CONCURRENCY (default: 2 x CPU cores + 1)
# Number of worker processes. Each holds its own DB connection and memory, so
# lower it on small machines or containers with tight memory limits.
# WEB_CONCURRENCY=3

# GUNICORN_THREADS (default: 1)
# Threads per worker. Above 1, workers handle requests concurrently in
# threads, which helps for I/O-bound views. Each thread holds a DB connection.
# GUNICORN_THREADS=1

# GUNICORN_TIMEOUT (default: 30)
# Seconds a worker may spend on one request before it is killed and
# restarted. Raise for slow endpoints (reports, exports).
# GUNICORN_TIMEOUT=30

# GUNICORN_GRACEFUL_TIMEOUT (default: 30)
# Seconds workers get to finish in-flight requests on restart/shutdown.
# GUNICORN_GRACEFUL_TIMEOUT=30

# GUNICORN_KEEPALIVE (default: 5)
# Seconds to keep an idle HTTP keep-alive connection open. Set slightly higher
# than the load balancer's idle timeout when one sits in front.
# GUNICORN_KEEPALIVE=5

# GUNICORN_MAX_REQUESTS (default: 1000)
# Restart a worker after this many requests, capping slow memory leaks.
# 0 disables.
# GUNICORN_MAX_REQUESTS=1000

# GUNICORN_MAX_REQUESTS_JITTER (default: 100)
# Random 0..N added to MAX_REQUESTS so workers don't all restart at once.
# GUNICORN_MAX_REQUESTS_JITTER=100

# GUNICORN_FORWARDED_ALLOW_IPS (default: 127.0.0.1,::1)
# IPs of reverse proxies trusted to set X-Forwarded-* headers. Set to the
# proxy's IP, or * only when the network guarantees all traffic comes through
# the proxy (e.g. inside a container platform).
# GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1,::1

# GUNICORN_LOG_LEVEL (default: info)
# Gunicorn's own log level: debug, info, warning, error, critical.
# Access and error logs go to stdout/stderr.
# GUNICORN_LOG_LEVEL=info


# =============================================================================
# LOGGING
# =============================================================================

# LOG_LEVEL (default: INFO)
# Minimum level logged to the console: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# Errors are additionally emailed to ADMINS when DEBUG=false.
# LOG_LEVEL=INFO


# =============================================================================
# THIRD-PARTY: DJANGO-SIMPLE-HISTORY
# =============================================================================

# SIMPLE_HISTORY_REVERT_DISABLED (default: false)
# Hide the "revert to this version" action in the admin history view, making
# history read-only for admins.
# SIMPLE_HISTORY_REVERT_DISABLED=false
